<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '44px 56px 24px 56px', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 32, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>2025年答卷：收入16.99亿元、扣非5.91亿元，盈利质量行业稀缺</Text>
        <Box style={{ width: '100%', height: 1, background: '#061F32', marginTop: 12 }} />
    </Box>
    <Box style={{ flexDirection: 'row', flex: 1, gap: 48, alignItems: 'center', marginTop: 12 }}>
        <Box style={{ flexDirection: 'column', gap: 44, width: '52%' }}>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 12 }}>
                    <Text style={{ fontSize: 96, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>16.99</Text>
                    <Text style={{ fontSize: 28, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>亿元</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#44546A', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>2025年营业收入　<span style={{ color: '#5A0E13', fontWeight: 'bold' }}>同比 +333%</span></Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 12 }}>
                    <Text style={{ fontSize: 96, color: '#08A6F6', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>5.91</Text>
                    <Text style={{ fontSize: 28, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>亿元</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#44546A', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>2025年扣非归母净利润　<span style={{ color: '#5A0E13', fontWeight: 'bold' }}>同比 +652.78%</span></Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 24, flex: 1 }}>
            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6, borderLeft: '3px solid #061F32', paddingLeft: 16 }}>
                    <Text style={{ fontSize: 40, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>140%</Text>
                    <Text style={{ fontSize: 16, color: '#808080', lineHeight: 1.4, fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>2022–2025营收复合增速</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6, borderLeft: '3px solid #061F32', paddingLeft: 16 }}>
                    <Text style={{ fontSize: 40, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>34.8%</Text>
                    <Text style={{ fontSize: 16, color: '#808080', lineHeight: 1.4, fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>2025年扣非净利率</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6, borderLeft: '3px solid #061F32', paddingLeft: 16 }}>
                    <Text style={{ fontSize: 40, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>51.07%</Text>
                    <Text style={{ fontSize: 16, color: '#808080', lineHeight: 1.4, fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>人形机器人收入占比</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6, borderLeft: '3px solid #061F32', paddingLeft: 16 }}>
                    <Text style={{ fontSize: 40, color: '#061F32', fontWeight: 'bold', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>5,500+</Text>
                    <Text style={{ fontSize: 16, color: '#808080', lineHeight: 1.4, fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>2025年人形机器人出货（台，全球第一）</Text>
                </Box>
            </Box>
            <Box style={{ background: '#F5F5F5', padding: '16px 20px', borderLeft: '3px solid #08A6F6' }}>
                <Text style={{ fontSize: 18, color: '#061F32', lineHeight: 1.5, fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>在普遍亏损的具身智能行业，公司是少数实现<span style={{ fontWeight: 'bold' }}>"规模化销售+盈利"</span>的样本——高成长已兑现，且具备现金流支撑（2025年经营净流入超6.7亿元）。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 12 }}>
        <Text style={{ fontSize: 14, color: '#808080', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>来源：公司2025年年度报告、招股说明书（申报稿），数据截至2026-08-30</Text>
        <Text style={{ fontSize: 14, color: '#808080', fontFamily: 'Arial, "PingFang SC", "Microsoft YaHei", sans-serif' }}>04</Text>
    </Box>
</Slide>
