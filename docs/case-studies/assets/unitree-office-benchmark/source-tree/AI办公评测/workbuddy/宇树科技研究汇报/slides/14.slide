            <Box style={{ position: 'absolute', left: 848, top: 16, width: 300, height: 100, background: '#FFFFFF', border: '1px solid #061F32', borderRadius: 4, zIndex: 1, padding: '12px 16px', flexDirection: 'column', gap: 4 }}>
